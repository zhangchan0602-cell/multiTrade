# 多因子选股系统 - 环境变量配置模板
# 复制为 .env 并填写实际值（.env 不应提交到版本控制）
# 使用方式：export $(cat .env | xargs) 或通过 direnv / shell profile 加载

# ── 必填 ─────────────────────────────────────────────────────────────────────
# Tushare Pro 令牌（用于 K 线/快照/复权因子的 fallback 数据源）
TUSHARE_TOKEN=your_tushare_token_here

# ── 性能调优（均有默认值，按需修改）────────────────────────────────────────
# K 线并发拉取线程数（2000 积分档建议 8，网络稳定时可尝试 10）
SHORT_KLINE_WORKERS=8

# 每只股票 K 线拉取最大重试次数（2000 积分档建议 3）
SHORT_KLINE_RETRIES=3

# K 线候选股数量上限（2000 积分档建议 1200；0 = 按比例自动计算）
SHORT_KLINE_CANDIDATE_LIMIT=1200

# ── 评分门槛（选填，调整筛选严格度）────────────────────────────────────────
# 盘后版：综合动量分下限，低于此分值不进入候选（默认 0.0）
SHORT_MOMENTUM_SCORE_FLOOR=0.0

# 盘后版：启动分下限（默认 -0.10）
SHORT_LAUNCH_SCORE_FLOOR=-0.10

# 尾盘版：综合动量分下限（默认 0.05）
SHORT_TAIL_MOMENTUM_SCORE_FLOOR=0.05

# 尾盘版：启动分下限（默认 0.02）
SHORT_TAIL_LAUNCH_SCORE_FLOOR=0.02

# ── 高级开关（调试/测试用）───────────────────────────────────────────────────
# 启用快速预筛（1=启用，0=跳过预筛直接拉全量 K 线；默认 1）
SHORT_FAST_PREFILTER=1

# 跳过 K 线拉取，全部使用快照估算（1=跳过；调试用，默认 0）
SHORT_SKIP_KLINE=0

# 强制使用 K 线 fallback 估算（1=强制；默认 0）
SHORT_KLINE_FALLBACK=0

# 要求真实 K 线数据（2000 积分档建议保持 1）
SHORT_REQUIRE_REAL_KLINE=1

# 允许纯快照兜底输出（2000 积分档建议 0，避免低置信候选）
SHORT_QUOTE_ONLY_FALLBACK=0

# 纯快照兜底最大输出股数（默认 50）
SHORT_QUOTE_ONLY_LIMIT=50
